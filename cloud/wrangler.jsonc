{
  "name": "ops-center-cloud",
  "keep_vars": true,
  "vars": {
    "WORKSPACE_COMMIT_RUNNER": "github-actions",
    "ONLINE_QUERY_ENABLED": "1",
    "PUBLICATION_RELIABLE": "1",
    "PUBLICATION_MAX_PENDING_BYTES": "268435456",
    "FOLLOWUP_DISK_MIGRATING": "0",
    "FOLLOWUP_DISK_ENABLED": "1"
  },
  "triggers": {
    "crons": [
      "0 9 * * *",
      "*/1 * * * *"
    ]
  },
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "account_id": "f898361a6c7974eea5b8c3d88cf1b452",
  "services": [
    {
      "binding": "FOLLOWUP_DISK_RELAY",
      "service": "ops-followup-disk-relay"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ops-center-cloud",
      "database_id": "59dab53e-19e5-4de6-a452-280ae22cdfa1"
    }
  ],
  "unsafe": {
    "metadata": {
      "keep_bindings": [
        "plain_text",
        "json",
        "secret_text",
        "secret_key",
        "assets"
      ],
      "keep_assets": true
    }
  }
}
